# Database
DATABASE_URL=postgresql+asyncpg://epiap:epiap_dev_secret@localhost:5433/epiap
DATABASE_URL_SYNC=postgresql://epiap:epiap_dev_secret@localhost:5433/epiap

# Jira
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_API_TOKEN=your-jira-api-token
JIRA_USER_EMAIL=you@company.com

# GitLab
GITLAB_BASE_URL=http://your-gitlab-host
GITLAB_TOKEN=glpat-xxxxxxxxxxxx
GITLAB_GROUPS=

# CI/CD - Jenkins
JENKINS_BASE_URL=https://jenkins.company.com
JENKINS_USER=admin
JENKINS_API_TOKEN=your-jenkins-token

# Claude AI
CLAUDE_USAGE_API_URL=https://api.anthropic.com/v1/usage
CLAUDE_API_KEY=sk-ant-xxxxx

# Polling intervals (seconds)
JIRA_POLL_INTERVAL=300
GITLAB_POLL_INTERVAL=900
CICD_POLL_INTERVAL=300
CLAUDE_POLL_INTERVAL=3600
BIZVALUE_POLL_INTERVAL=7200
METRIC_COMPUTE_INTERVAL=86400
